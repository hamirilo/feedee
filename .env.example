# Copy to `.env` and replace with local or production values.
# GitHub PAT (read:packages) for downloading @hamirilo/ui from GitHub Packages during Docker build
PACKAGES_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GITHUB_TOKEN も後方互換として認識されます

DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True
DATABASE_URL=postgresql://feedee:feedee@postgres:5432/feedee

POSTGRES_DB=feedee
POSTGRES_USER=feedee
POSTGRES_PASSWORD=feedee
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web,backend,feedee-web,10.0.0.100,100.81.153.20,mac-mini-m4,.tail4dde35.ts.net,.ts.net,feedee.macmini
CSRF_TRUSTED_ORIGINS=http://localhost:8004,http://127.0.0.1:8004,http://10.0.0.100:8004,http://10.0.0.100,http://100.81.153.20,http://100.81.153.20:8004,http://mac-mini-m4,http://*.tail4dde35.ts.net,http://*.ts.net,http://feedee.macmini

WORKER_API_TOKEN=change-me-to-a-random-token

# 共通ログイン passport（decisions/adr-0002-passport-login.md）。
# secret は passport の `just sync-products` が出す。
PASSPORT_CLIENT_SECRET=
PASSPORT_INTERNAL_URL=http://127.0.0.1:8888

# FastAPI backend (v2)
FASTAPI_SECRET_KEY=change-me-to-a-random-secret-key
FASTAPI_DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000
