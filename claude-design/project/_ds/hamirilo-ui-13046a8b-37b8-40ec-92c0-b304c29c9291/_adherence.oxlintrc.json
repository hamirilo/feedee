        "selector": "JSXOpeningElement[name.name='HamiriloThemeToggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|iconClassName|ariaLabel|onToggle|theme|key|ref|className|style|children)$/]",
        "message": "<HamiriloThemeToggle> doesn't accept that prop. Declared props: className, iconClassName, ariaLabel, onToggle, theme."
