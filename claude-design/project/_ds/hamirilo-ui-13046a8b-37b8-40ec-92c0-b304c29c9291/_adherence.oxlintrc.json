        "selector": "JSXOpeningElement[name.name='HamiriloProgress'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|max|label|showValue|className|ref|key|ref|className|style|children)$/]",
        "message": "<HamiriloProgress> doesn't accept that prop. Declared props: value, max, label, showValue, className, ref."
      },
      {
        "selector": "JSXOpeningElement[name.name='HamiriloRadioGroup'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|value|defaultValue|onValueChange|orientation|disabled|required|name|className|ref|key|ref|className|style|children)$/]",
        "message": "<HamiriloRadioGroup> doesn't accept that prop. Declared props: items, value, defaultValue, onValueChange, orientation, disabled, required, name, className, ref."
      },
      {
        "selector": "JSXOpeningElement[name.name='HamiriloRadioGroup'] > JSXAttribute[name.name='orientation'] > Literal[value!=/^(?:horizontal|vertical)$/]",
        "message": "<HamiriloRadioGroup> orientation must be one of 'horizontal' | 'vertical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HamiriloSearchInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:onClear|className|style|id|children|error|ref|key|ref|className|style|children)$/]",
        "message": "<HamiriloSearchInput> doesn't accept that prop. Declared props: onClear, className, style, id, children, error, ref."
      },
      {
        "selector": "JSXOpeningElement[name.name='HamiriloSelect'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|value|defaultValue|onValueChange|placeholder|disabled|error|name|required|id|className|ref|key|ref|className|style|children)$/]",
        "message": "<HamiriloSelect> doesn't accept that prop. Declared props: items, value, defaultValue, onValueChange, placeholder, disabled, error, name, required, id, className, ref."
      },
      {
        "selector": "JSXOpeningElement[name.name='HamiriloSidebarItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|icon|badge|children|className|id|style|ref|key|ref|className|style|children)$/]",
