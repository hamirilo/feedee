{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/components/HamiriloActiveIndicator/**",
              "components/components/HamiriloBadge/**",
              "components/components/HamiriloButton/**",
              "components/components/HamiriloButtonGroup/**",
              "components/components/HamiriloCard/**",
              "components/components/HamiriloCheckbox/**",
              "components/components/HamiriloConfirmDialog/**",
              "components/components/HamiriloDatePicker/**",
              "components/components/HamiriloDialog/**",
              "components/components/HamiriloDropdown/**",
              "components/components/HamiriloFormDialog/**",
              "components/components/HamiriloFormField/**",
              "components/components/HamiriloInput/**",
              "components/components/HamiriloNavItem/**",
              "components/components/HamiriloPagination/**",
              "components/components/HamiriloProgress/**",
              "components/components/HamiriloRadioGroup/**",
              "components/components/HamiriloSearchInput/**",
              "components/components/HamiriloSelect/**",
              "components/components/HamiriloSidebarItem/**",
              "components/components/HamiriloSpinner/**",
              "components/components/HamiriloTable/**",
              "components/components/HamiriloTabs/**",
              "components/components/HamiriloTextarea/**",
              "components/components/HamiriloThemeToggle/**",
              "components/components/HamiriloToast/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|IBM Plex Sans JP))/i]",
        "message": "Font not provided by the design system. Available: Inter, IBM Plex Sans JP."
      },
      {
        "selector": "JSXOpeningElement[name.name='HamiriloActiveIndicator'] > JSXAttribute > JSXIdentifier[name!=/^(?:layoutId|className|key|ref|className|style|children)$/]",
        "message": "<HamiriloActiveIndicator> doesn't accept that prop. Declared props: layoutId, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='HamiriloBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|icon|className|style|id|children|ref|key|ref|className|style|children)$/]",
        "message": "<HamiriloBadge> doesn't accept that prop. Declared props: tone, icon, className, style, id, children, ref."
      },
      {
        "selector": "JSXOpeningElement[name.name='HamiriloBadge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:danger|warning|new|active|done|pending|neutral)$/]",
        "message": "<HamiriloBadge> tone must be one of 'danger' | 'warning' | 'new' | 'active' | 'done' | 'pending' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HamiriloButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|className|style|id|children|focusableWhenDisabled|nativeButton|render|size|loading|leftIcon|rightIcon|ref|key|ref|className|style|children)$/]",
        "message": "<HamiriloButton> doesn't accept that prop. Declared props: variant, className, style, id, children, focusableWhenDisabled, nativeButton, render, size, loading, leftIcon, rightIcon, ref."
      },
      {
        "selector": "JSXOpeningElement[name.name='HamiriloButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:link|secondary|ghost|primary|danger|success)$/]",
        "message": "<HamiriloButton> variant must be one of 'link' | 'secondary' | 'ghost' | 'primary' | 'danger' | 'success'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HamiriloButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:default|sm|lg|icon)$/]",
        "message": "<HamiriloButton> size must be one of 'default' | 'sm' | 'lg' | 'icon'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HamiriloButtonGroup'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|value|defaultValue|onValueChange|variant|size|disabled|name|required|className|ref|key|ref|className|style|children)$/]",
        "message": "<HamiriloButtonGroup> doesn't accept that prop. Declared props: items, value, defaultValue, onValueChange, variant, size, disabled, name, required, className, ref."
      },
      {
        "selector": "JSXOpeningElement[name.name='HamiriloButtonGroup'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:secondary|primary)$/]",
        "message": "<HamiriloButtonGroup> variant must be one of 'secondary' | 'primary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HamiriloButtonGroup'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|lg|md)$/]",
        "message": "<HamiriloButtonGroup> size must be one of 'sm' | 'lg' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HamiriloCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:padding|title|action|footer|className|style|id|children|ref|key|ref|className|style|children)$/]",
        "message": "<HamiriloCard> doesn't accept that prop. Declared props: padding, title, action, footer, className, style, id, children, ref."
      },
      {
        "selector": "JSXOpeningElement[name.name='HamiriloCard'] > JSXAttribute[name.name='padding'] > Literal[value!=/^(?:sm|lg|md)$/]",
        "message": "<HamiriloCard> padding must be one of 'sm' | 'lg' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HamiriloCheckbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|description|wrapperClassName|className|defaultChecked|style|form|disabled|name|value|id|nativeButton|render|checked|readOnly|required|indeterminate|inputRef|parent|uncheckedValue|ref|key|ref|className|style|children)$/]",
        "message": "<HamiriloCheckbox> doesn't accept that prop. Declared props: label, description, wrapperClassName, className, defaultChecked, style, form, disabled, name, value, id, nativeButton, render, checked, readOnly, required, indeterminate, inputRef, parent, uncheckedValue, ref."
      },
      {
        "selector": "JSXOpeningElement[name.name='HamiriloConfirmDialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onOpenChange|title|message|detail|type|confirmText|cancelText|onConfirm|onCancel|key|ref|className|style|children)$/]",
        "message": "<HamiriloConfirmDialog> doesn't accept that prop. Declared props: open, onOpenChange, title, message, detail, type, confirmText, cancelText, onConfirm, onCancel."
      },
      {
        "selector": "JSXOpeningElement[name.name='HamiriloConfirmDialog'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:danger|success|info|warning)$/]",
        "message": "<HamiriloConfirmDialog> type must be one of 'danger' | 'success' | 'info' | 'warning'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HamiriloDatePicker'] > JSXAttribute > JSXIdentifier[name!=/^(?:mode|value|onChange|placeholder|disabled|minDate|maxDate|className|key|ref|className|style|children)$/]",
        "message": "<HamiriloDatePicker> doesn't accept that prop. Declared props: mode, value, onChange, placeholder, disabled, minDate, maxDate, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='HamiriloDatePicker'] > JSXAttribute[name.name='mode'] > Literal[value!=/^(?:multiple|range|single)$/]",
        "message": "<HamiriloDatePicker> mode must be one of 'multiple' | 'range' | 'single'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HamiriloDialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onOpenChange|title|description|children|footer|confirmText|cancelText|onConfirm|onCancel|confirmVariant|confirmLoading|maxWidth|key|ref|className|style|children)$/]",
        "message": "<HamiriloDialog> doesn't accept that prop. Declared props: open, onOpenChange, title, description, children, footer, confirmText, cancelText, onConfirm, onCancel, confirmVariant, confirmLoading, maxWidth."
      },
      {
        "selector": "JSXOpeningElement[name.name='HamiriloDialog'] > JSXAttribute[name.name='confirmVariant'] > Literal[value!=/^(?:primary|danger|success)$/]",
        "message": "<HamiriloDialog> confirmVariant must be one of 'primary' | 'danger' | 'success'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HamiriloDialog'] > JSXAttribute[name.name='maxWidth'] > Literal[value!=/^(?:sm|lg|md|xl|2xl)$/]",
        "message": "<HamiriloDialog> maxWidth must be one of 'sm' | 'lg' | 'md' | 'xl' | '2xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HamiriloDropdown'] > JSXAttribute > JSXIdentifier[name!=/^(?:trigger|items|label|align|key|ref|className|style|children)$/]",
        "message": "<HamiriloDropdown> doesn't accept that prop. Declared props: trigger, items, label, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='HamiriloDropdown'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|start|end)$/]",
        "message": "<HamiriloDropdown> align must be one of 'center' | 'start' | 'end'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HamiriloFormDialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onOpenChange|title|description|children|submitText|cancelText|onSubmit|onCancel|submitVariant|loading|disabled|maxWidth|key|ref|className|style|children)$/]",
        "message": "<HamiriloFormDialog> doesn't accept that prop. Declared props: open, onOpenChange, title, description, children, submitText, cancelText, onSubmit, onCancel, submitVariant, loading, disabled, maxWidth."
      },
      {
        "selector": "JSXOpeningElement[name.name='HamiriloFormDialog'] > JSXAttribute[name.name='submitVariant'] > Literal[value!=/^(?:primary|success)$/]",
        "message": "<HamiriloFormDialog> submitVariant must be one of 'primary' | 'success'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HamiriloFormDialog'] > JSXAttribute[name.name='maxWidth'] > Literal[value!=/^(?:sm|lg|md|xl|2xl)$/]",
        "message": "<HamiriloFormDialog> maxWidth must be one of 'sm' | 'lg' | 'md' | 'xl' | '2xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HamiriloFormField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|required|error|helpText|children|htmlFor|className|key|ref|className|style|children)$/]",
        "message": "<HamiriloFormField> doesn't accept that prop. Declared props: label, required, error, helpText, children, htmlFor, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='HamiriloInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:error|leftIcon|rightIcon|className|style|id|children|ref|key|ref|className|style|children)$/]",
        "message": "<HamiriloInput> doesn't accept that prop. Declared props: error, leftIcon, rightIcon, className, style, id, children, ref."
      },
      {
        "selector": "JSXOpeningElement[name.name='HamiriloNavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|icon|label|badge|activeColor|layoutId|className|children|style|id|ref|key|ref|className|style|children)$/]",
        "message": "<HamiriloNavItem> doesn't accept that prop. Declared props: active, icon, label, badge, activeColor, layoutId, className, children, style, id, ref."
      },
      {
        "selector": "JSXOpeningElement[name.name='HamiriloNavItem'] > JSXAttribute[name.name='activeColor'] > Literal[value!=/^(?:primary|blue|indigo|teal|amber|rose|emerald)$/]",
        "message": "<HamiriloNavItem> activeColor must be one of 'primary' | 'blue' | 'indigo' | 'teal' | 'amber' | 'rose' | 'emerald'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HamiriloPagination'] > JSXAttribute > JSXIdentifier[name!=/^(?:page|totalPages|onPageChange|siblingCount|className|ref|key|ref|className|style|children)$/]",
